# Copiá este archivo como .env.local para desarrollo, y cargá estas mismas
# variables en Vercel (Project Settings → Environment Variables).
# NUNCA commitees el .env.local real: ya está ignorado en .gitignore.

# API key de Resend (la misma cuenta de Save2App sirve)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Casilla donde llegan los mensajes del formulario
CONTACT_TO=jcsoaresgache@gmail.com

# Remitente. Debe ser una dirección de un dominio VERIFICADO en Resend.
# Mientras no verifiques el dominio de Hashtag, podés usar el dominio ya
# verificado de Save2App (el visitante no ve esta dirección).
CONTACT_FROM=Hashtag Digital <contacto@tudominioverificado.com>
